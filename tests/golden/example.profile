# AppArmor profile for myapp
# Generated by apparmor-profile-action from a declarative spec.
# Edit the spec, not this file -- re-running the action overwrites it.

abi <abi/3.0>,
include <tunables/global>

profile myapp /usr/bin/myapp flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/openssl>

  # capabilities
  capability net_bind_service,
  capability setgid,
  capability setuid,

  # network
  network inet stream,
  network inet6 stream,
  network inet dgram,

  # files
  "/dev/urandom" r,
  "/etc/myapp/**" r,
  "/usr/lib/myapp/**" r,
  "/usr/lib/myapp/*.so*" mr,
  "/usr/share/myapp/**" r,
  "/var/lib/myapp/**" rw,
  "/var/log/myapp/*.log" ra,
  "/var/run/myapp/*.pid" rw,

  # executables
  "/usr/bin/myapp-worker" rix,
  "/usr/bin/convert" rPx,

  # signal
  signal (send) set=(term,int) peer=myapp,

  # unix
  unix (bind, listen, accept) type=stream addr="@myapp-*",

  # denials (these win over any allow rule above)
  deny "/etc/**" w,
  deny "/etc/shadow" r,
  deny "/etc/ssh/**" r,
  deny "/home/**" r,
  deny "/usr/**" w,

  # verbatim rules from the spec
  owner /var/lib/myapp/** rwk,
  /proc/sys/kernel/random/uuid r,
}
