# AppArmor profile for myapp
# Generated by apparmor-profile-action (runtime learning).
# Source: runtime learning of 'aa-learn-myapp'.
# Merged with the rules already committed here: re-running the
# action only ever adds. To drop a rule, delete it -- it stays
# gone unless the workload is observed needing it again.

include <tunables/global>

profile myapp flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>

  # Container baseline (mirrors docker-default's hardening)
  deny @{PROC}/* w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/k[^e]** w,
  deny @{PROC}/sys/ke[^r]** w,
  deny @{PROC}/sys/ker[^n]** w,
  deny @{PROC}/sys/kern[^e]** w,
  deny @{PROC}/sys/kerne[^l]** w,
  deny @{PROC}/sys/kernel/{,**} wklx,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/firmware/{,**} rwklx,
  deny mount,

  # capabilities
  capability chown,
  capability net_bind_service,
  capability sys_ptrace,

  # network
  network inet stream,
  network inet6 stream,

  # unix sockets
  unix (create) type=stream,

  # signals
  signal (send) set=(term) peer=unconfined,

  # ptrace
  ptrace (read) peer=unconfined,

  # executables
  "/usr/bin/helper" rix,

  # files
  "/etc/myapp/config.yaml" r,
  "/etc/resolv.conf" r,
  "/etc/ssl/certs/ca-certificates.crt" r,
  "/usr/lib/python3.12/email/parser.py" r,
  "/usr/lib/x86_64-linux-gnu/libfoo.so.1" mr,
  "/var/log/myapp/app.log" w,
  "/var/run/secrets/kubernetes.io/serviceaccount/token" r,
}
