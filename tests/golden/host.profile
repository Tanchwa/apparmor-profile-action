# AppArmor profile for myapp
# Generated by apparmor-profile-action (runtime learning).
# Source: 12 audit records from profile 'aa-learn-myapp'.
# Edit by hand if you need to tighten it -- re-running the action
# regenerates this file wholesale.

abi <abi/3.0>,
include <tunables/global>

profile myapp /usr/bin/myapp flags=(attach_disconnected,mediate_deleted,complain) {
  include <abstractions/base>

  # capabilities
  capability chown,
  capability net_bind_service,

  # network
  network inet stream,

  # unix sockets
  unix (create) type=stream,

  # signals
  signal (send) set=(term) peer=unconfined,

  # ptrace
  ptrace (read) peer=unconfined,

  # executables
  "/usr/bin/helper" rix,

  # files
  "/etc/myapp/config.yaml" r,
  "/proc/4211/status" r,
  "/proc/4299/status" r,
  "/usr/lib/x86_64-linux-gnu/libfoo.so.1" mr,
  "/var/log/myapp/app.log" w,
}
