# AppArmor profile for minimal
# Generated by apparmor-profile-action from a declarative spec.
# Edit the spec, not this file -- re-running the action overwrites it.

include <tunables/global>

profile minimal flags=(attach_disconnected,mediate_deleted,complain) {
  include <abstractions/base>

  # capabilities
  capability chown,

  # network
  network inet stream,

  # files
  "/etc/minimal.conf" r,
  "/var/lib/minimal/**" rw,

  # denials (these win over any allow rule above)
  deny "/etc/**" w,
}
